NUXT_RESEND_API_KEY=
NUXT_CONTACT_EMAIL=contacto@carlesfar.com

# Public Supabase configuration used by the Nuxt client.
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Environment marker used by Cuebooker builds.
NUXT_PUBLIC_APP_ENV=local

# Google Tag Manager container. Leave empty to keep analytics disabled.
NUXT_PUBLIC_GTM_ID=
